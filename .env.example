# Kisan Shakti Environment Configuration
# Copy this file to .env and configure as needed.

APP_NAME="Kisan Shakti"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# Database Configuration
DATABASE_URL="sqlite:///./kisan_shakti.db"

# Model Configuration
DISEASE_MODEL_PATH="models/disease/plant_disease_model.pth"
DISEASE_CLASS_MAP="models/disease/class_mapping.json"
DISEASE_METADATA="models/disease/metadata.json"
CONFIDENCE_THRESHOLD=0.60

# Optional Gemini API integration for open-ended conversational questions.
# Without a key, the assistant uses its local crop/scheme/advisory knowledge.
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.8-flash"
# BHASHINI_API_KEY=""

# Security and CORS
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501","http://localhost:3000","http://127.0.0.1:3000"]
MAX_UPLOAD_SIZE_MB=10
